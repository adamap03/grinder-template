# Grinder settings. Copy to .env.napi (Docker) and fill in. Never commit the filled-in file.

# Notion: create an internal integration (notion.so/my-integrations), create an empty page for Grinder's data,
# share that page with the integration, and paste the page id. The app creates its tables there on first use.
NOTION_TOKEN=ntn_xxx
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude (console.anthropic.com). Models are optional; defaults are set in src/lib/claude.server.ts.
ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_SEARCH_MODEL=claude-haiku-5-5

# Signs sign-in tokens: any long random string (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string

# Built-in IStructE Find an Engineer source in Discover. Leave off unless IStructE has given you permission.
ISTRUCTE_DIRECTORY=off
