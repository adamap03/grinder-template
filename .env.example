# Optional Grinder settings. A fresh copy needs none of these: the setup page in the browser connects Notion (and
# optionally Claude) and saves them in the data volume. Anything set here (copy this file to .env.napi) wins over that.
# Never commit the filled-in file.

# Notion: an internal integration secret and the page Grinder keeps its tables on (shared with the integration).
# NOTION_TOKEN=ntn_xxx
# NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude (console.anthropic.com), for the AI features. Models are optional; defaults are in src/lib/claude.server.ts.
# ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_SEARCH_MODEL=claude-haiku-5-5

# Signs sign-in tokens. Generated and saved automatically when not set; changing it signs everyone out.
# AUTH_SECRET=a-long-random-string

# Built-in IStructE Find an Engineer source in Discover. Leave off unless IStructE has given you permission.
ISTRUCTE_DIRECTORY=off

# Optional script added to every page, e.g. a dashboard's visitor tracker.
# VISITOR_TRACKER_URL=http://localhost:3000/t.js
